default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: false,
      in_house: false,
    )

    key_path = File.join(Dir.tmpdir, "AuthKey_#{ENV['ASC_KEY_ID']}.p8")
    File.write(key_path, ENV["ASC_KEY_P8"])

    update_code_signing_settings(
      use_automatic_signing: true,
      team_id: ENV["APPLE_TEAM_ID"],
      path: "Introibo.xcodeproj",
    )

    version = "1.5.5"
    increment_version_number(version_number: version, xcodeproj: "Introibo.xcodeproj")
    latest = latest_testflight_build_number(api_key: api_key, app_identifier: "app.introibo.Introibo", version: version) rescue 0
    new_build = latest + 1
    increment_build_number(build_number: new_build, xcodeproj: "Introibo.xcodeproj")
    UI.message("Version #{version}, Build number: #{new_build}")

    archive_path = File.join(Dir.tmpdir, "Introibo.xcarchive")

    # Archive
    sh(
      "xcodebuild",
      "-project", "../Introibo.xcodeproj",
      "-scheme", "Introibo",
      "-destination", "generic/platform=iOS",
      "-archivePath", archive_path,
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", key_path,
      "-authenticationKeyID", ENV["ASC_KEY_ID"],
      "-authenticationKeyIssuerID", ENV["ASC_ISSUER_ID"],
      "archive",
    )

    # Write export options plist
    export_plist = File.join(Dir.tmpdir, "ExportOptions.plist")
    File.write(export_plist, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key>
        <string>app-store</string>
        <key>signingStyle</key>
        <string>automatic</string>
        <key>teamID</key>
        <string>#{ENV["APPLE_TEAM_ID"]}</string>
      </dict>
      </plist>
    PLIST

    # Export
    sh(
      "xcodebuild",
      "-exportArchive",
      "-archivePath", archive_path,
      "-exportPath", "..",
      "-exportOptionsPlist", export_plist,
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", key_path,
      "-authenticationKeyID", ENV["ASC_KEY_ID"],
      "-authenticationKeyIssuerID", ENV["ASC_ISSUER_ID"],
    )

    # Find the exported IPA
    ipa_path = File.join("..", "Introibo.ipa")
    ipa_abs = File.expand_path(ipa_path)
    UI.message("Looking for IPA at: #{ipa_abs}")

    changelog = <<~NOTES
      What's new in 1.2.1.

      Accurate calendar through 2050: the 1962 calendar has been
      rebuilt from an authoritative source and verified day-by-day —
      correct feasts, transfers, octaves, and privileged ferias for
      every day from 2024 to 2050.

      Fuller Divine Office: English translations now cover the great
      majority of the Office (antiphons, lessons, responsories,
      hymns, collects), and the Saturday Office of the Blessed Virgin
      Mary is now included, with its proper seasonal forms.

      English for every day: every feast and feria now shows an
      English name on the home screen and calendar, across all three
      rites (1962 / 1955 / pre-1955).

      Cleaner text: removed stray formatting marks that could appear
      in some Office prayers, and fixed the bilingual section
      headings so the English title sits centered beneath the Latin.

      Plus assorted calendar and Office corrections from your feedback.
    NOTES

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_abs,
      skip_waiting_for_build_processing: true,
      changelog: changelog,
    )
  end
end
