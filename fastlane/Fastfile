default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: false,
      in_house: false,
    )

    key_path = File.join(Dir.tmpdir, "AuthKey_#{ENV['ASC_KEY_ID']}.p8")
    File.write(key_path, ENV["ASC_KEY_P8"])

    update_code_signing_settings(
      use_automatic_signing: true,
      team_id: ENV["APPLE_TEAM_ID"],
      path: "Introibo.xcodeproj",
    )

    version = "1.5.2"
    increment_version_number(version_number: version, xcodeproj: "Introibo.xcodeproj")
    latest = latest_testflight_build_number(api_key: api_key, app_identifier: "app.introibo.Introibo", version: version) rescue 0
    new_build = latest + 1
    increment_build_number(build_number: new_build, xcodeproj: "Introibo.xcodeproj")
    UI.message("Version #{version}, Build number: #{new_build}")

    archive_path = File.join(Dir.tmpdir, "Introibo.xcarchive")

    # Archive
    sh(
      "xcodebuild",
      "-project", "../Introibo.xcodeproj",
      "-scheme", "Introibo",
      "-destination", "generic/platform=iOS",
      "-archivePath", archive_path,
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", key_path,
      "-authenticationKeyID", ENV["ASC_KEY_ID"],
      "-authenticationKeyIssuerID", ENV["ASC_ISSUER_ID"],
      "archive",
    )

    # Write export options plist
    export_plist = File.join(Dir.tmpdir, "ExportOptions.plist")
    File.write(export_plist, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key>
        <string>app-store</string>
        <key>signingStyle</key>
        <string>automatic</string>
        <key>teamID</key>
        <string>#{ENV["APPLE_TEAM_ID"]}</string>
      </dict>
      </plist>
    PLIST

    # Export
    sh(
      "xcodebuild",
      "-exportArchive",
      "-archivePath", archive_path,
      "-exportPath", "..",
      "-exportOptionsPlist", export_plist,
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", key_path,
      "-authenticationKeyID", ENV["ASC_KEY_ID"],
      "-authenticationKeyIssuerID", ENV["ASC_ISSUER_ID"],
    )

    # Find the exported IPA
    ipa_path = File.join("..", "Introibo.ipa")
    ipa_abs = File.expand_path(ipa_path)
    UI.message("Looking for IPA at: #{ipa_abs}")

    changelog = <<~NOTES
      Tier 1 content correctness pass.

      Mass: Restored Wednesday Luke Passion, Good Friday Mass,
      Easter Vigil (1962 + pre-1955 forms). Corrected All Souls,
      All Saints, Sts Peter & Paul Mass content. Doctor/Apostle/
      Evangelist feasts now show Credo. Sundays after Pentecost
      and Epiphany now green.

      Office: Added Litany of the Saints, Athanasian Creed,
      and Office of the Dead.

      Calendar: Holy Family transfers to Jan 13 when Epiphany
      falls on Sunday. 1962 abolished apostle vigils stripped.
      38 previously-blank sanctoral days now resolve.

      Pre-1955: Palm Sunday Last Gospel substitution now works.
      Marian antiphon boundaries corrected at Feb 2, Triduum,
      Saturday before Advent.
    NOTES

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_abs,
      skip_waiting_for_build_processing: true,
      changelog: changelog,
    )
  end
end
