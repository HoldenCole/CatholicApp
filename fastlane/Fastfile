default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: false,
      in_house: false,
    )

    key_path = File.join(Dir.tmpdir, "AuthKey_#{ENV['ASC_KEY_ID']}.p8")
    File.write(key_path, ENV["ASC_KEY_P8"])

    update_code_signing_settings(
      use_automatic_signing: true,
      team_id: ENV["APPLE_TEAM_ID"],
      path: "Introibo.xcodeproj",
    )

    # Must be bumped once a train ships on the App Store — Apple closes the
    # approved version for new build submissions (409 Invalid Pre-Release Train).
    version = "1.5.8"
    increment_version_number(version_number: version, xcodeproj: "Introibo.xcodeproj")
    latest = latest_testflight_build_number(api_key: api_key, app_identifier: "app.introibo.Introibo", version: version) rescue 0
    # Two pushes minutes apart both saw the same "latest" (the first upload
    # was still processing) and collided on the same build number (409
    # Redundant Binary Upload). The workflow run number is unique and
    # monotonic, so take whichever is higher.
    new_build = [latest + 1, (ENV["GITHUB_RUN_NUMBER"] || "0").to_i].max
    increment_build_number(build_number: new_build, xcodeproj: "Introibo.xcodeproj")
    UI.message("Version #{version}, Build number: #{new_build}")

    archive_path = File.join(Dir.tmpdir, "Introibo.xcarchive")

    # Archive UNSIGNED; signing happens at export (below), where automatic
    # signing + -allowProvisioningUpdates provably works with this API key.
    # Signing at archive time instead fails in GatherProvisioningInputs with
    # "Authentication failed: bearer token" on the CI runners — every deploy
    # between 2026-07-14 and 2026-07-20 silently failed that way after these
    # flags moved out of the project's base settings. Keep them HERE (CI
    # archive only) so local Xcode builds retain clean automatic signing.
    sh(
      "xcodebuild",
      "-project", "../Introibo.xcodeproj",
      "-scheme", "Introibo",
      "-destination", "generic/platform=iOS",
      "-archivePath", archive_path,
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", key_path,
      "-authenticationKeyID", ENV["ASC_KEY_ID"],
      "-authenticationKeyIssuerID", ENV["ASC_ISSUER_ID"],
      "CODE_SIGN_IDENTITY=",
      "CODE_SIGNING_REQUIRED=NO",
      "CODE_SIGNING_ALLOWED=NO",
      "archive",
    )

    # The archive above is UNSIGNED, so nothing has embedded the targets'
    # entitlements — the App Group the widget extension shares with the app.
    # -exportArchive re-signs from whatever the archive's binaries carry, and
    # a binary with no signature carries nothing: every TestFlight build
    # shipped without com.apple.security.application-groups, the app and the
    # widgets each got a private container, and the Readings and Sanctorale
    # widgets never saw the snapshots the app wrote ("Open the app to
    # refresh…" for ever; widget settings without effect). Sign the archived
    # binaries ad hoc here WITH their entitlements (xcodegen writes the files
    # from project.yml) so the distribution signature keeps the App Group.
    app_path = File.join(archive_path, "Products", "Applications", "Introibo.app")
    appex_path = File.join(app_path, "PlugIns", "IntroiboWidgets.appex")
    app_ent = File.expand_path("../Introibo/Introibo.entitlements")
    appex_ent = File.expand_path("../IntroiboWidgets/IntroiboWidgets.entitlements")
    [app_ent, appex_ent].each { |f| UI.user_error!("Missing entitlements file #{f} — run xcodegen generate") unless File.exist?(f) }
    UI.user_error!("Widget extension not in archive: #{appex_path}") unless File.directory?(appex_path)
    sh("codesign", "--force", "--sign", "-", "--entitlements", appex_ent, appex_path)
    sh("codesign", "--force", "--sign", "-", "--entitlements", app_ent, app_path)

    # Write export options plist
    export_plist = File.join(Dir.tmpdir, "ExportOptions.plist")
    File.write(export_plist, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key>
        <string>app-store</string>
        <key>signingStyle</key>
        <string>automatic</string>
        <key>teamID</key>
        <string>#{ENV["APPLE_TEAM_ID"]}</string>
      </dict>
      </plist>
    PLIST

    # Export. Automatic signing at export needs an App Store profile that
    # carries the App Group; when none exists Xcode tries to create one
    # through the API key, and if the portal refuses ("Authentication
    # failed" / "No profiles ... were found") the build must still ship:
    # strip the ad hoc signatures and export as before, WITHOUT the App
    # Group, and say so loudly — the widgets stay broken until the Apple
    # side is fixed (see the warning text below).
    export = lambda do
      sh(
        "xcodebuild",
        "-exportArchive",
        "-archivePath", archive_path,
        "-exportPath", "..",
        "-exportOptionsPlist", export_plist,
        "-allowProvisioningUpdates",
        "-authenticationKeyPath", key_path,
        "-authenticationKeyID", ENV["ASC_KEY_ID"],
        "-authenticationKeyIssuerID", ENV["ASC_ISSUER_ID"],
      )
    end
    app_group_signed = true
    begin
      export.call
    rescue StandardError => e
      app_group_signed = false
      UI.important("Export with the App Group entitlement failed: #{e.message.lines.first&.strip}")
      UI.important("Retrying without it so the build ships; the widgets will NOT share data with the app.")
      sh("codesign", "--remove-signature", appex_path)
      sh("codesign", "--remove-signature", app_path)
      export.call
    end

    # Find the exported IPA
    ipa_path = File.join("..", "Introibo.ipa")
    ipa_abs = File.expand_path(ipa_path)
    UI.message("Looking for IPA at: #{ipa_abs}")

    # Refuse to ship a build whose app or widget extension lost the App Group:
    # the widgets would be broken again, silently.
    unpacked = File.join(Dir.tmpdir, "Introibo-ipa-check")
    FileUtils.rm_rf(unpacked)
    sh("unzip", "-q", ipa_abs, "-d", unpacked)
    signed_app = Dir.glob(File.join(unpacked, "Payload", "*.app")).first
    UI.user_error!("No .app in the exported IPA") unless signed_app
    portal_help = "The App Store profiles for app.introibo.Introibo and app.introibo.Introibo.widgets " \
      "must carry the App Group group.app.introibo.Introibo. In the Apple Developer portal enable App Groups " \
      "on both App IDs with that group, and give the App Store Connect API key a role that may manage " \
      "certificates, identifiers and profiles (Admin, or App Manager with that access) so Xcode can " \
      "regenerate the profiles at export — or archive and upload once from Xcode with automatic signing, " \
      "which registers everything; later CI exports then find the profiles."
    [signed_app, File.join(signed_app, "PlugIns", "IntroiboWidgets.appex")].each do |bundle|
      ents = sh("codesign", "-d", "--entitlements", "-", "--xml", bundle, log: false)
      if ents.include?("group.app.introibo.Introibo")
        UI.success("#{File.basename(bundle)}: App Group entitlement present")
      elsif app_group_signed
        UI.user_error!("#{File.basename(bundle)} was exported WITHOUT the App Group entitlement:\n#{ents}")
      else
        msg = "#{File.basename(bundle)} shipped WITHOUT the App Group entitlement: the Readings and Sanctorale " \
          "widgets will show 'Open the app to refresh' and ignore their settings. #{portal_help}"
        UI.important(msg)
        puts "::warning title=Widgets broken in this TestFlight build::#{msg}"
      end
    end

    changelog = <<~NOTES
      Español: the app is now 100% translated. The Divine Office joins
      the Missal — the whole Psalter and every antiphon, responsory,
      lesson, collect, and hymn of the temporal cycle, the commons, and
      the saints' feasts, with Scripture from the classic public-domain
      Torres Amat Bible and the hymns in their traditional verse
      translations — plus the Rosary's mysteries and prayers.
    NOTES

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_abs,
      skip_waiting_for_build_processing: true,
      changelog: changelog,
    )
  end
end
