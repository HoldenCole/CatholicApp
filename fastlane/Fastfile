default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: false,
      in_house: false,
    )

    key_path = File.join(Dir.tmpdir, "AuthKey_#{ENV['ASC_KEY_ID']}.p8")
    File.write(key_path, ENV["ASC_KEY_P8"])

    update_code_signing_settings(
      use_automatic_signing: true,
      team_id: ENV["APPLE_TEAM_ID"],
      path: "Introibo.xcodeproj",
    )

    # Must be bumped once a train ships on the App Store — Apple closes the
    # approved version for new build submissions (409 Invalid Pre-Release Train).
    version = "1.5.8"
    increment_version_number(version_number: version, xcodeproj: "Introibo.xcodeproj")
    latest = latest_testflight_build_number(api_key: api_key, app_identifier: "app.introibo.Introibo", version: version) rescue 0
    new_build = latest + 1
    increment_build_number(build_number: new_build, xcodeproj: "Introibo.xcodeproj")
    UI.message("Version #{version}, Build number: #{new_build}")

    archive_path = File.join(Dir.tmpdir, "Introibo.xcarchive")

    # Archive UNSIGNED; signing happens at export (below), where automatic
    # signing + -allowProvisioningUpdates provably works with this API key.
    # Signing at archive time instead fails in GatherProvisioningInputs with
    # "Authentication failed: bearer token" on the CI runners — every deploy
    # between 2026-07-14 and 2026-07-20 silently failed that way after these
    # flags moved out of the project's base settings. Keep them HERE (CI
    # archive only) so local Xcode builds retain clean automatic signing.
    sh(
      "xcodebuild",
      "-project", "../Introibo.xcodeproj",
      "-scheme", "Introibo",
      "-destination", "generic/platform=iOS",
      "-archivePath", archive_path,
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", key_path,
      "-authenticationKeyID", ENV["ASC_KEY_ID"],
      "-authenticationKeyIssuerID", ENV["ASC_ISSUER_ID"],
      "CODE_SIGN_IDENTITY=",
      "CODE_SIGNING_REQUIRED=NO",
      "CODE_SIGNING_ALLOWED=NO",
      "archive",
    )

    # Write export options plist
    export_plist = File.join(Dir.tmpdir, "ExportOptions.plist")
    File.write(export_plist, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key>
        <string>app-store</string>
        <key>signingStyle</key>
        <string>automatic</string>
        <key>teamID</key>
        <string>#{ENV["APPLE_TEAM_ID"]}</string>
      </dict>
      </plist>
    PLIST

    # Export
    sh(
      "xcodebuild",
      "-exportArchive",
      "-archivePath", archive_path,
      "-exportPath", "..",
      "-exportOptionsPlist", export_plist,
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", key_path,
      "-authenticationKeyID", ENV["ASC_KEY_ID"],
      "-authenticationKeyIssuerID", ENV["ASC_ISSUER_ID"],
    )

    # Find the exported IPA
    ipa_path = File.join("..", "Introibo.ipa")
    ipa_abs = File.expand_path(ipa_path)
    UI.message("Looking for IPA at: #{ipa_abs}")

    changelog = <<~NOTES
      Español: the app is now 100% translated. The Divine Office joins
      the Missal — the whole Psalter and every antiphon, responsory,
      lesson, collect, and hymn of the temporal cycle, the commons, and
      the saints' feasts, with Scripture from the classic public-domain
      Torres Amat Bible and the hymns in their traditional verse
      translations — plus the Rosary's mysteries and prayers.
    NOTES

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_abs,
      skip_waiting_for_build_processing: true,
      changelog: changelog,
    )
  end
end
