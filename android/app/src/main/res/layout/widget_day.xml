<?xml version="1.0" encoding="utf-8"?>
<!-- Today's Feast widget: the day of the liturgical calendar you are on.
     RemoteViews-safe views only (no bare View). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/day_color_pip"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="5dp" />

        <TextView
            android:id="@+id/day_season"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/eb_garamond_regular"
            android:textSize="9sp"
            android:letterSpacing="0.14"
            android:textColor="#8B1A1A"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />
    </LinearLayout>

    <TextView
        android:id="@+id/day_title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/playfair_display_regular"
        android:textSize="15sp"
        android:textColor="#1A130C"
        android:maxLines="4"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:text="" />

    <TextView
        android:id="@+id/day_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/eb_garamond_italic"
        android:textSize="10sp"
        android:textColor="#4C3E31"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />

</LinearLayout>
