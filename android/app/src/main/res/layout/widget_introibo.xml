<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: an invitation to pray. Parchment surface, Sanctuary
     Red rule, EB Garamond text — the Cistercian system at ambient scale.
     No progress/tracking elements of any kind (wellbeing CUT LINE). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/eb_garamond_regular"
        android:textSize="11sp"
        android:letterSpacing="0.18"
        android:textAllCaps="true"
        android:textColor="#8B1A1A"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_label_office" />

    <View
        android:layout_width="28dp"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:background="#C9A227" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/playfair_display_regular"
        android:textSize="20sp"
        android:textColor="#1A130C"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Laudes" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/eb_garamond_italic"
        android:textSize="13sp"
        android:textColor="#4C3E31"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_tap_to_pray" />

</LinearLayout>
