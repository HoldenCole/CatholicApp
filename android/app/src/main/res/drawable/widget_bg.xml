<?xml version="1.0" encoding="utf-8"?>
<!-- Parchment card with a hairline walnut border, matching the app's
     surface treatment. Corner radius follows system widget conventions. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F2E8D0" />
    <stroke
        android:width="1dp"
        android:color="#331A130C" />
    <corners android:radius="16dp" />
</shape>
