<?xml version="1.0" encoding="utf-8"?>
<!-- Missal-page surface: warm top-lit parchment gradient inside a double
     hairline frame (walnut outer, gold leaf inner). Pure drawable — safe for
     RemoteViews. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#F8F2E2"
                android:centerColor="#F2E8D0"
                android:endColor="#E7D9BB" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#471A130C" />
        </shape>
    </item>
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="11dp" />
            <stroke
                android:width="1dp"
                android:color="#66C9A227" />
        </shape>
    </item>
</layer-list>
