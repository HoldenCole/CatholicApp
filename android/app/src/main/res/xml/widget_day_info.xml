<?xml version="1.0" encoding="utf-8"?>
<!-- Today's Feast: 2x2 small card; content changes at local midnight via the
     provider's own alarm, never by polling. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:maxResizeWidth="220dp"
    android:maxResizeHeight="220dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_day"
    android:previewLayout="@layout/widget_day"
    android:widgetCategory="home_screen"
    android:description="@string/widget_day_description" />
