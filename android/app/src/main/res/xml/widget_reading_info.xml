<?xml version="1.0" encoding="utf-8"?>
<!-- Daily Reading: 4x2 wide card; content changes at local midnight via the
     provider's own alarm, never by polling. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:maxResizeWidth="360dp"
    android:maxResizeHeight="360dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_reading"
    android:previewLayout="@layout/widget_reading"
    android:widgetCategory="home_screen"
    android:description="@string/widget_reading_description" />
