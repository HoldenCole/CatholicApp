<?xml version="1.0" encoding="utf-8"?>
<!-- Sanctorale: 4x3 tall card; content changes at local midnight via the
     provider's own alarm, never by polling. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:maxResizeWidth="360dp"
    android:maxResizeHeight="450dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_saints"
    android:previewLayout="@layout/widget_saints"
    android:widgetCategory="home_screen"
    android:description="@string/widget_saints_description" />
