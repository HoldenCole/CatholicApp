<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window chrome before Compose draws. System bars are transparent
         and drawn behind by the app (see MainActivity.applySystemBars);
         the colours below are the Introibo palette, not the template purple. -->
    <style name="Theme.Introibo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/parchment</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Walnut, walnut, gold leaf, parchment: see ui/theme/Palette.kt -->
    <color name="primary">#1A130C</color>
    <color name="primary_dark">#1A130C</color>
    <color name="accent">#B8960C</color>
    <color name="parchment">#F2E8D0</color>
</resources>
